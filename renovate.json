{
  "extends": [
    "github>zekihan/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go dependencies"
    },
    {
      "description": "Review immutable GitHub Action pins; keep release comments",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "automerge": false
    }
  ]
}
